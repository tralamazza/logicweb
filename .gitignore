node_modules/
dist/

# Generated by src/decode/tools/vendor-assets.mjs - 13 MB of Pyodide runtime and
# the stock sigrok decoder sources. Regenerate rather than commit.
public/pyodide/
public/decoders/

# CPython bytecode. src/decode/py/ is imported by build-manifest.py with the host
# interpreter, so running any tool that touches it used to dirty tracked .pyc files
# and show up as unrelated changes in every commit.
__pycache__/
*.pyc
